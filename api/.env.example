# Postgres connection string. Locally, the Docker Postgres that
# ./scripts/dev.sh starts (container gym-db, host port 5433):
#   postgres://postgres:postgres@localhost:5433/gymdb
# In production (Vercel env vars), use Supabase's Connect -> Transaction
# pooler string (port 6543), not the direct connection (5432) — the direct
# connection is only for one-time scripts like scripts/migrate.py.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/gymdb

# From the Supabase project: Project Settings -> API -> Project URL. Session
# JWTs are signed with the project's JWT Signing Keys (ES256); this is used to
# fetch the public JWKS for verification. Every /api/sync route needs it and
# answers 500 while it is empty.
SUPABASE_URL=

# Comma-separated origins allowed to call the API cross-origin. The deployed
# web build is same-origin behind Vercel rewrites and doesn't need this; it
# matters for local dev (Expo web on 8443, Metro on 8081/19006). The native app
# has no origin at all, so CORS doesn't apply to it.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:8443

# Max size of the asyncpg pool. Keep small — Supabase's pooler already
# multiplexes many serverless instances onto a shared set of connections.
DB_POOL_MAX=3

# Only used by `uvicorn app.main:app --port $PORT` locally. Irrelevant on
# Vercel, which has no port concept for serverless functions.
PORT=8000
