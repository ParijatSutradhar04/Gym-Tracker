# Absolute API origin. Android has no same-origin relative path, so it always
# needs this. On web it's optional — when unset, requests fall back to relative
# "/api", which only resolves once Vercel rewrites /api/* to the FastAPI
# function (see /vercel.json). For local web dev against ./scripts/dev.sh, keep
# it at localhost. A physical phone can't reach your Mac's localhost: use the
# Mac's LAN IP instead (e.g. http://192.168.1.20:8000).
EXPO_PUBLIC_API_URL=http://localhost:8000

# From the Supabase project: Project Settings -> API -> Project URL (the same
# value as SUPABASE_URL in api/.env).
EXPO_PUBLIC_SUPABASE_URL=

# From the Supabase project: Project Settings -> API Keys -> the anon (public)
# key. Safe to ship in the app; sign-ups are disabled on the project, so it
# only lets the one existing user sign in.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
